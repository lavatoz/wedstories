datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Template {
  id            String       @id @default(uuid())
  slug          String       @unique
  name          String
  category      String
  description   String?
  previewImage  String
  componentName String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  invitations   Invitation[]
}

enum MediaType {
  IMAGE
  AUDIO
}

model Media {
  id           String     @id @default(uuid())
  type         MediaType
  originalName String
  mimeType     String
  size         Int
  storageKey   String     @unique
  url          String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  couplePhotos Invitation[]      @relation("CouplePhoto")
  bridePhotos  Invitation[]      @relation("BridePhoto")
  groomPhotos  Invitation[]      @relation("GroomPhoto")
  musicAudios  Invitation[]      @relation("MusicAudio")
  galleryImages GalleryImage[]
  storyImages   StoryMilestone[]
}

model Invitation {
  id             String            @id @default(uuid())
  slug           String            @unique
  templateId     String
  brideName      String
  groomName      String
  weddingDate    String
  weddingTime    String
  venue          String
  location       String
  customMessage  String?
  rsvpName       String?
  rsvpPhone      String?
  couplePhotoId  String?
  bridePhotoId   String?
  groomPhotoId   String?
  musicName      String?
  musicAudioId   String?
  musicEnabled   Boolean           @default(false)
  musicVolume    Float             @default(0.7)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  template       Template          @relation(fields: [templateId], references: [slug])
  events         InvitationEvent[]
  website        WebsiteSettings?
  story          StoryMilestone[]
  gallery        GalleryImage[]
  guestRsvps     GuestRSVP[]
  wishes         Wish[]
  couplePhoto    Media?            @relation("CouplePhoto", fields: [couplePhotoId], references: [id], onDelete: SetNull)
  bridePhoto     Media?            @relation("BridePhoto", fields: [bridePhotoId], references: [id], onDelete: SetNull)
  groomPhoto     Media?            @relation("GroomPhoto", fields: [groomPhotoId], references: [id], onDelete: SetNull)
  musicAudio     Media?            @relation("MusicAudio", fields: [musicAudioId], references: [id], onDelete: SetNull)
}

model InvitationEvent {
  id           String     @id @default(uuid())
  invitationId String
  name         String
  date         String
  time         String
  venue        String
  location     String?
  order        Int        @default(0)

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model WebsiteSettings {
  id             String     @id @default(uuid())
  invitationId   String     @unique
  heroTitle      String?
  introText      String?
  storyTitle     String?    @default("Our Story")
  galleryTitle   String?    @default("Moments")
  scheduleTitle  String?    @default("Wedding Details")
  rsvpTitle      String?    @default("RSVP")
  wishesTitle    String?    @default("Wedding Wishes")
  showStory      Boolean    @default(true)
  showGallery    Boolean    @default(true)
  showRsvp       Boolean    @default(true)
  showWishes     Boolean    @default(true)
  primaryColor   String      @default("#8B6B3F")
  backgroundColor String     @default("#F7F4EE")
  headingFont    String      @default("Playfair Display")
  bodyFont       String      @default("Inter")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  invitation     Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model StoryMilestone {
  id           String      @id @default(uuid())
  invitationId String
  title        String
  date         String?
  description  String
  imageId      String?
  order        Int         @default(0)
  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  image        Media?      @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([invitationId, order])
}

model GalleryImage {
  id           String      @id @default(uuid())
  invitationId String
  mediaId      String
  caption      String?
  order        Int         @default(0)
  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  media        Media       @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([invitationId, order])
}

enum RSVPResponse {
  YES
  NO
  MAYBE
}

model GuestRSVP {
  id           String        @id @default(uuid())
  invitationId String
  name         String
  email        String?
  phone        String?
  response     RSVPResponse
  message      String?
  createdAt    DateTime      @default(now())
  invitation   Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
}

enum WishStatus {
  PENDING
  APPROVED
  REJECTED
}

model Wish {
  id           String      @id @default(uuid())
  invitationId String
  name         String
  message      String
  status       WishStatus  @default(PENDING)
  createdAt    DateTime    @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, status, createdAt])
}
